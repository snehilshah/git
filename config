[credential]
	helper = store

[include]
	path = /home/snehilshah/.config/git/delta.gitconfig

[init]
	defaultBranch = main

[user]
	email = snehil.shah@nviz.com
	name = snehilrshah
	signingKey = 

[core]
	pager = delta
	editor = nvim
	compression = 9
	whitespace = error
	preloadindex = true
	autocrlf = input

[status]
	showUntrackedFiles = all
	branch = true
	showStash = true

[interactive]
	diffFilter = delta --color-only --features=interactive

[merge]
	conflictStyle = zdiff3
	ff = false

[diff]
	context = 3
	renames = copies
	interHunkContext = 10
	algorithm = histogram

[maintenance]
	repo = /home/snehilshah/projects/nitro-api

[rebase]
	updateRefs = true

[rerere]
	enabled = true
[http]
	cookiefile = /home/snehilshah/.gitcookies

[color]
	ui = true
	status = auto
	diff = auto
	branch = auto
	grep = auto
[gpg]
	format = 
	program = gpg
[commit]
	gpgSign = false
[push]
	autoSetupRemote = true
[tag]
	forceSignAnnotated = false
[gpg "ssh"]
	program = 
	allowedSignersFile = 
[credential "https://github.com"]
	helper = 
	helper = !/home/linuxbrew/.linuxbrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/home/linuxbrew/.linuxbrew/bin/gh auth git-credential
[coderabbit]
	machineId = cli/77bb4a9f30ea45bd91a77a53277dd986
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[fetch]
	prune = true
