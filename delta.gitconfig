[delta]
	navigate = true
	dark = true
	side-by-side = false
	line-numbers = true
	line-numbers-left-format = "{nm:>4}┊"
	line-numbers-right-format = "{np:>4}│"
	line-numbers-left-style = "#7daea3"
	line-numbers-right-style = "#7daea3"
	line-numbers-minus-style = "#E07A5F"
	line-numbers-plus-style = "#98971a"
	line-numbers-zero-style = "#928374"
	minus-style = "#EBDBB2" "#4D2A2A"
	minus-emph-style = "#FBF1C7" "#6B3838"
	plus-style = "#EBDBB2" "#34452F"
	plus-emph-style = "#FBF1C7" "#51683B"
	syntax-theme = base16
	file-style = omit
	hunk-header-decoration-style = bold "#7daea3" ul
	hunk-header-file-style = bold "#E07A5F"
	hunk-header-style = bold file syntax
	whitespace-error-style = "#E07A5F" reverse
	zero-style = syntax
	blame-code-style = syntax
	blame-format = "{author:<18} ({commit:>8}) {timestamp:^12} "
	blame-palette = "#1d2021" "#292929" "#404040" "#595959"
