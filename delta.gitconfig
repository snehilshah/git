[delta]
	navigate = true
	dark = true
	side-by-side = false
	line-numbers = true
	line-numbers-left-format = "{nm:>4}┊"
	line-numbers-right-format = "{np:>4}│"
	line-numbers-left-style = "#7daea3"
	line-numbers-right-style = "#7daea3"
	line-numbers-minus-style = "#ea6962"
	line-numbers-plus-style = "#a9b665"
	line-numbers-zero-style = "#928374"
	minus-style = syntax "#570707ff"
	minus-emph-style = "#136406ff" "#ea6962"
	plus-style = syntax "#226e13ff"
	plus-emph-style = "#1d2021" "#79b665ff"
	syntax-theme = base16
	file-style = bold "#d8a657" ul
	file-decoration-style = bold "#d8a657" ul
	hunk-header-decoration-style = bold "#7daea3" ul
	hunk-header-file-style = bold "#ea6962"
	hunk-header-line-number-style = bold "#a9b665"
	hunk-header-style = bold file line-number syntax
	whitespace-error-style = "#ea6962" reverse
	zero-style = syntax
	blame-code-style = syntax
	blame-format = "{author:<18} ({commit:>8}) {timestamp:^12} "
	blame-palette = "#1d2021" "#292929" "#404040" "#595959"
